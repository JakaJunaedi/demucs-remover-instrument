@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --bg-primary: #12121a;
    --bg-card: #1c1c27;
    --bg-sidebar: #0f0f15;
    --bg-hover: #2d2d3a;
    --accent-primary: #ff7b54;
    --accent-secondary: #c955ff;
    --accent-success: #10b981;
    --accent-warning: #f59e0b;
    --accent-error: #ef4444;
    --text-primary: #ffffff;
    --text-secondary: #8c8c9e;
    --border: #2a2a35;
  }
  
  body {
    @apply bg-background text-slate-100 antialiased;
  }
}

@layer utilities {
  .animate-equalizer {
    animation: equalize 1s infinite alternate ease-in-out;
  }
  
  .animation-delay-100 { animation-delay: 100ms; }
  .animation-delay-200 { animation-delay: 200ms; }
  .animation-delay-300 { animation-delay: 300ms; }
  .animation-delay-400 { animation-delay: 400ms; }
}

@keyframes equalize {
  0% { height: 0.5rem; }
  100% { height: 3rem; }
}
